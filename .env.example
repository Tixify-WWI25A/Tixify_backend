# Kopieren nach .env (wird nicht eingecheckt) und Werte eintragen.
# Auf Heroku: heroku config:set NAME=wert -a tixify

# Postgres und Redis (auf Heroku automatisch gesetzt, die Add-ons gehören zur App "tixify")
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tixify
REDIS_URL=redis://localhost:6379

# Muss in gateway, catalog und orders IDENTISCH sein
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Wohin das gateway weiterleitet (auf Heroku: die https-Adressen der beiden Apps)
CATALOG_URL=http://localhost:3001
ORDERS_URL=http://localhost:3002

# Welche Frontends das gateway aufrufen dürfen (kommagetrennt, ohne Schrägstrich am Ende)
CORS_ORIGINS=http://localhost:4200,http://localhost:5500

# Optional
PORT=3000
# Lebensdauer des Event-Caches im gateway (Millisekunden)
CACHE_TTL_MS=30000
