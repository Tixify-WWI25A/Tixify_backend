{
  "name": "tixify-gateway",
  "version": "1.0.0",
  "description": "Tixify gateway: einziger Einstiegspunkt (Weiterleitung, Cache, CORS, Rate-Limit) und identity-Service (Registrierung, Login, Nutzerverwaltung)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand --coverage",
    "set-admin": "node scripts/set-admin.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.16",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/setupEnv.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
